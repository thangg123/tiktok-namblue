<?xml version="1.0" encoding="utf-8"?>
<!-- Section chips: focused = solid accent with white ring; the active section keeps an accent
     outline when the cursor is elsewhere, so you can always tell which list is showing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#22A7F0" />
            <corners android:radius="24dp" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#123247" />
            <corners android:radius="24dp" />
            <stroke android:width="2dp" android:color="#22A7F0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#16222E" />
            <corners android:radius="24dp" />
            <stroke android:width="2dp" android:color="#33485E" />
        </shape>
    </item>
</selector>
