<?xml version="1.0" encoding="utf-8"?>
<!-- Profile finder: type a username (opens straight away) or a name (searched, needs login).
     Profiles opened before sit under "Đã xem"; hold OK on one to remove it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <WebView
        android:id="@+id/scrapeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:paddingTop="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_search_title"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/queryInput"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:hint="@string/profile_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:nextFocusRight="@+id/btnFind"
                android:paddingHorizontal="20dp"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textColorHint="#9FB3C8"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnFind"
                android:layout_width="180dp"
                android:layout_height="68dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/btn_chooser_bg"
                android:nextFocusLeft="@+id/queryInput"
                android:text="@string/search_go"
                android:textAllCaps="false"
                android:textColor="@color/btn_chooser_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/historySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_history_title"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingVertical="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/historyList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#9FB3C8"
            android:textSize="18sp" />

        <ScrollView
            android:id="@+id/resultScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:scrollbars="none">

            <GridLayout
                android:id="@+id/resultGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="6" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
